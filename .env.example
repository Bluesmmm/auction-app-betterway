NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://auction_app:auction_app@localhost:5432/auction_app?schema=public
REDIS_URL=redis://localhost:6379/0
WORKER_NAME=auction-worker-local
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=30
API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
MINIPROGRAM_API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_TOKEN_SIGNING_KEY=local-auth-token-current
OBJECT_STORAGE_KEY_CURRENT=local-object-storage-current
OBJECT_STORAGE_KEY_NEXT=local-object-storage-next
SUBSCRIPTION_MESSAGE_SECRET_CURRENT=local-subscription-current
SUBSCRIPTION_MESSAGE_SECRET_NEXT=local-subscription-next
LOG_EXPORT_SIGNING_KEY_CURRENT=local-log-export-current
LOG_EXPORT_SIGNING_KEY_NEXT=local-log-export-next
