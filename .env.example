NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://auction_app:auction_app@localhost:5432/auction_app?schema=public
REDIS_URL=redis://localhost:6379/0
WORKER_NAME=auction-worker-local
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=30
LEDGER_CHECK_INTERVAL_SECONDS=300
OUTBOX_DISPATCH_INTERVAL_SECONDS=10
OUTBOX_DISPATCH_LIMIT=50
OUTBOX_DISPATCH_LEASE_SECONDS=300
AUCTION_SETTLEMENT_SCAN_INTERVAL_SECONDS=60
AUCTION_SETTLEMENT_SCAN_LIMIT=50
TRANSACTION_TIMEOUT_SCAN_INTERVAL_SECONDS=60
TRANSACTION_TIMEOUT_SCAN_LIMIT=50
API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
MINIPROGRAM_API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_TOKEN_SIGNING_KEY=__REPLACE_WITH_LOCAL_AUTH_TOKEN_SIGNING_KEY__
OBJECT_STORAGE_KEY_CURRENT=__REPLACE_WITH_LOCAL_OBJECT_STORAGE_KEY_CURRENT__
OBJECT_STORAGE_KEY_NEXT=__REPLACE_WITH_LOCAL_OBJECT_STORAGE_KEY_NEXT__
SUBSCRIPTION_MESSAGE_SECRET_CURRENT=__REPLACE_WITH_LOCAL_SUBSCRIPTION_SECRET_CURRENT__
SUBSCRIPTION_MESSAGE_SECRET_NEXT=__REPLACE_WITH_LOCAL_SUBSCRIPTION_SECRET_NEXT__
LOG_EXPORT_SIGNING_KEY_CURRENT=__REPLACE_WITH_LOCAL_LOG_EXPORT_SIGNING_KEY_CURRENT__
LOG_EXPORT_SIGNING_KEY_NEXT=__REPLACE_WITH_LOCAL_LOG_EXPORT_SIGNING_KEY_NEXT__
