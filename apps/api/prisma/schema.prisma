generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  restricted
  closed
}

enum GuardianStatus {
  active
  restricted
  closed
}

enum ChildStatus {
  pending_guardian
  active
  restricted
  closed
}

enum GuardianRole {
  primary
  secondary
}

enum AdminRole {
  activity_admin
  platform_admin
  institution_admin
}

enum LinkStatus {
  pending
  active
  revoked
}

enum CommunityStatus {
  draft
  pending_review
  active
  suspended
  closed
  rejected
}

enum InviteCodeStatus {
  active
  disabled
  expired
}

enum CommunityMemberStatus {
  pending_guardian
  pending_admin
  active
  removed
  banned
}

enum AdminScopeStatus {
  active
  suspended
  revoked
}

enum GovernanceControlScopeType {
  platform
  community
}

enum GovernanceControlType {
  pause_publish
  pause_bid
  pause_settlement
  force_platform_review
}

enum GovernanceControlStatus {
  active
  lifted
  expired
}

enum HighRiskGovernanceReviewActionType {
  governance_control_create
  governance_control_lift
}

enum HighRiskGovernanceReviewDecisionState {
  pending
  approved
  rejected
  expired
  withdrawn
  invalidated
}

enum HighRiskGovernanceReviewExecutionState {
  not_started
  succeeded
  failed
}

enum HighRiskGovernanceReviewEventType {
  created
  approved
  rejected
  withdrawn
  expired
  invalidated
  execution_succeeded
  execution_failed
}

enum ContentTargetType {
  item
  wanted_request
  wanted_response
  avatar
}

enum ContentVersionStatus {
  pending_ai
  pending_manual
  approved
  rejected
  escalated
  blocked
}

enum ModerationTaskStatus {
  pending
  processing
  needs_manual_review
  approved
  rejected
  escalated
  blocked
  failed
}

enum AiProviderStatus {
  success
  timeout
  failed
  invalid_response
}

enum ManualReviewDecision {
  approve
  reject
  escalate
  block
}

enum MediaVisibility {
  temp_private
  formal_private
  deleted
}

enum ContentMediaRole {
  front
  back
  side
  detail
  avatar
}

enum ItemStatus {
  draft
  ai_reviewing
  manual_reviewing
  approved
  rejected
  listed
  withdrawn
  delisted
}

enum WantedPostStatus {
  draft
  ai_reviewing
  manual_reviewing
  active
  closed
  rejected
  delisted
}

enum WantedResponseStatus {
  submitted
  reviewing
  approved
  converted_to_item
  rejected
  cancelled
}

enum AuctionSessionStatus {
  pending_start
  active
  pending_settlement
  settled
  cancelled
  unsold
  delisted
}

enum BidStatus {
  active
  outbid
  withdrawn
  invalidated
}

enum PointHoldStatus {
  active
  released
  transferred
  cancelled
  disputed
}

enum PointLedgerEntryType {
  initial_grant
  admin_award
  admin_penalty
  correction
  admin_adjustment
  hold
  release
  transfer_out
  transfer_in
  reversal
}

enum PointAdjustmentSource {
  guardian_request
  admin_initiated
}

enum PointAdjustmentRequestType {
  correction
  activity_reward
  admin_award
  admin_penalty
  batch_award
}

enum PointAdjustmentStatus {
  pending_review
  pending_second_review
  approved
  rejected
  cancelled
}

enum LedgerCheckRunStatus {
  running
  passed
  failed
  skipped
}

enum LedgerCheckDiffType {
  snapshot_mismatch
  negative_replay
  orphan_ledger_entry
  missing_account
  active_hold_mismatch
}

enum TransactionStatus {
  pending_guardian_confirm
  pending_delivery_confirm
  completed
  cancelled
  disputed
  platform_review
}

enum DecisionPhase {
  guardian_confirm
  delivery_confirm
}

enum DecisionValue {
  confirmed
  rejected
}

enum TransactionSide {
  buyer
  seller
}

enum DeliveryMethod {
  designated_point
  guardian_arranged
  courier
}

enum DeliveryPointStatus {
  active
  disabled
}

enum DeliveryRecordStatus {
  pending
  completed
  disputed
  admin_resolved
}

enum AppealTargetType {
  transaction
}

enum AppealStatus {
  pending_activity_admin
  resolved
  escalated_platform
  platform_resolved
  rejected
}

enum AppealAttachmentStatus {
  pending_scan
  accepted
  escalated_platform
  rejected
}

enum IdempotencyStatus {
  processing
  completed
  failed
  conflict
}

enum OutboxStatus {
  pending
  processing
  sent
  failed
  cancelled
}

enum NotificationType {
  auction_bid_accepted
  auction_bid_outbid
  auction_bid_withdrawn
  auction_settled
  auction_unsold
  auction_cancelled
  transaction_guardian_confirmed
  transaction_cancelled
  transaction_completed
  transaction_disputed
  transaction_platform_review_required
  high_risk_governance_review_pending
  high_risk_governance_review_result
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  suppressed
}

enum NotificationActionType {
  view_auction
  view_transaction
  view_appeal
  view_points
  open_search_result
  view_high_risk_governance_review
}

enum SearchIndexTargetType {
  item
  wanted_post
}

enum SearchIndexVisibilityStatus {
  searchable
  hidden
  delisted
}

enum ItemFavoriteStatus {
  active
  removed
}

enum SessionStatus {
  active
  revoked
  expired
}

enum TrustedDeviceTrustLevel {
  normal
  sensitive_allowed
  revoked
}

enum SensitiveOperationChallengeStatus {
  pending
  passed
  failed
  expired
  cooling_down
}

enum GuardianDisputeStatus {
  pending_platform_review
  frozen
  resolved
  rejected
}

enum GuardianDisputeType {
  guardian_change
  unlink
  deletion
  consent
  transaction
}

enum CommunityCreationRequestStatus {
  pending_review
  approved
  rejected
  cancelled
}

enum CommunityRuleVersionStatus {
  draft
  active
  retired
}

enum RosterVerificationStatus {
  pending
  matched
  not_matched
  manual_exception
  rejected
}

enum RiskSignalType {
  adult_impersonation_suspected
  abnormal_join_pattern
  contact_inducement_suspected
  cross_community_anomaly
  guardian_account_takeover_suspected
}

enum RiskSignalStatus {
  open
  under_review
  resolved
  dismissed
}

enum RiskRestrictionType {
  no_join
  no_publish
  no_bid
  no_transaction_confirm
  no_export
  no_delete
  sensitive_challenge_required
  suspended
}

enum RiskRestrictionScope {
  user
  guardian
  child
  community_member
  community
}

enum RiskRestrictionStatus {
  active
  resolved
  expired
}

model User {
  id                                 String                            @id @default(cuid())
  status                             UserStatus                        @default(active)
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  wechatIdentities                   WechatIdentity[]
  guardianProfile                    GuardianProfile?
  adminProfile                       AdminProfile?
  childProfile                       ChildProfile?
  sessions                           UserSession[]
  trustedDevices                     TrustedDevice[]
  sensitiveOperationChallenges       SensitiveOperationChallenge[]     @relation("SensitiveOperationChallengeActor")
  reviewedCommunityRequests          CommunityCreationRequest[]        @relation("CommunityCreationRequestReviewer")
  adminReviewedCommunityMembers      CommunityMember[]                 @relation("CommunityMemberAdminReviewer")
  reviewedRiskSignals                RiskSignal[]                      @relation("RiskSignalReviewer")
  targetRiskSignals                  RiskSignal[]                      @relation("RiskSignalTargetUser")
  imposedRiskRestrictions            RiskRestriction[]                 @relation("RiskRestrictionImposedBy")
  targetRiskRestrictions             RiskRestriction[]                 @relation("RiskRestrictionTargetUser")
  auditLogs                          AuditLog[]
  createdLedgerEntries               PointLedgerEntry[]
  createdAuctionSessions             AuctionSession[]                  @relation("AuctionSessionCreatedBy")
  requestedPointAdjustments          PointAdjustmentRequest[]          @relation("PointAdjustmentRequestedBy")
  reviewedPointAdjustments           PointAdjustmentRequest[]          @relation("PointAdjustmentReviewedBy")
  secondReviewedPointAdjustments     PointAdjustmentRequest[]          @relation("PointAdjustmentSecondReviewedBy")
  manualReviewRecords                ManualReviewRecord[]              @relation("ManualReviewRecordReviewer")
  reviewedAppeals                    Appeal[]                          @relation("AppealReviewer")
  createdGovernanceControls          GovernanceControl[]               @relation("GovernanceControlCreatedBy")
  liftedGovernanceControls           GovernanceControl[]               @relation("GovernanceControlLiftedBy")
  initiatedHighRiskGovernanceReviews HighRiskGovernanceReviewRequest[] @relation("HighRiskGovernanceReviewInitiator")
  reviewedHighRiskGovernanceReviews  HighRiskGovernanceReviewRequest[] @relation("HighRiskGovernanceReviewReviewer")
  highRiskGovernanceReviewEvents     HighRiskGovernanceReviewEvent[]   @relation("HighRiskGovernanceReviewEventActor")
  notifications                      Notification[]
  notificationPreferences            NotificationPreference[]
}

model WechatIdentity {
  id          String    @id @default(cuid())
  userId      String
  openid      String    @unique
  unionid     String?
  avatarUrl   String?
  nickname    String?
  lastLoginAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model GuardianProfile {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  phoneHash                 String
  phoneLast4                String
  consentVersion            String
  consentedAt               DateTime
  status                    GuardianStatus             @default(active)
  user                      User                       @relation(fields: [userId], references: [id])
  childLinks                GuardianChildLink[]
  communityCreationRequests CommunityCreationRequest[]
  submittedDisputes         GuardianDispute[]
  submittedAppeals          Appeal[]                   @relation("GuardianSubmittedAppeals")
  pointAdjustmentRequests   PointAdjustmentRequest[]
  riskSignals               RiskSignal[]
  riskRestrictions          RiskRestriction[]
}

model AdminProfile {
  id              String                @id @default(cuid())
  userId          String                @unique
  role            AdminRole
  mfaEnabled      Boolean               @default(false)
  status          UserStatus            @default(active)
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id])
  communityScopes AdminCommunityScope[]
}

model ChildProfile {
  id                      String                   @id @default(cuid())
  userId                  String?                  @unique
  displayName             String
  avatarAssetId           String?
  gradeBand               String
  status                  ChildStatus              @default(pending_guardian)
  createdByGuardianId     String?
  initialPointsGrantedAt  DateTime?
  createdAt               DateTime                 @default(now())
  user                    User?                    @relation(fields: [userId], references: [id])
  guardianLinks           GuardianChildLink[]
  guardianSettings        ChildGuardianSettings?
  guardianDisputes        GuardianDispute[]
  memberships             CommunityMember[]
  riskSignals             RiskSignal[]
  riskRestrictions        RiskRestriction[]
  pointAccount            PointAccount?
  ledgerEntries           PointLedgerEntry[]
  pointAdjustmentRequests PointAdjustmentRequest[]
  items                   Item[]
  wantedPosts             WantedPost[]
  wantedResponses         WantedResponse[]
  bids                    Bid[]
  guardianDecisions       GuardianDecision[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  itemFavorites           ItemFavorite[]
}

model GuardianChildLink {
  id          String          @id @default(cuid())
  guardianId  String
  childId     String
  role        GuardianRole
  status      LinkStatus      @default(pending)
  confirmedAt DateTime?
  guardian    GuardianProfile @relation(fields: [guardianId], references: [id])
  child       ChildProfile    @relation(fields: [childId], references: [id])

  @@unique([guardianId, childId])
  @@index([childId, role, status])
}

model AuctionCommunity {
  id                            String                            @id @default(cuid())
  name                          String
  description                   String?
  creatorGuardianId             String
  status                        CommunityStatus                   @default(draft)
  defaultAuctionDurationMinutes Int
  createdAt                     DateTime                          @default(now())
  creationRequest               CommunityCreationRequest?         @relation("CommunityCreatedFromRequest")
  inviteCodes                   CommunityInviteCode[]
  members                       CommunityMember[]
  adminScopes                   AdminCommunityScope[]
  ruleVersions                  CommunityRuleVersion[]
  riskSignals                   RiskSignal[]
  riskRestrictions              RiskRestriction[]
  items                         Item[]
  wantedPosts                   WantedPost[]
  deliveryPoints                DeliveryPoint[]
  appeals                       Appeal[]
  searchIndexDocuments          SearchIndexDocument[]
  itemFavorites                 ItemFavorite[]
  governanceControls            GovernanceControl[]
  highRiskGovernanceReviews     HighRiskGovernanceReviewRequest[]
}

model AdminCommunityScope {
  id             String           @id @default(cuid())
  adminProfileId String
  communityId    String
  status         AdminScopeStatus @default(active)
  createdAt      DateTime         @default(now())
  adminProfile   AdminProfile     @relation(fields: [adminProfileId], references: [id])
  community      AuctionCommunity @relation(fields: [communityId], references: [id])

  @@unique([adminProfileId, communityId])
  @@index([communityId, status])
}

model CommunityInviteCode {
  id            String                @id @default(cuid())
  communityId   String
  ruleVersionId String?
  code          String                @unique
  status        InviteCodeStatus      @default(active)
  maxUses       Int?
  usedCount     Int                   @default(0)
  expiresAt     DateTime?
  community     AuctionCommunity      @relation(fields: [communityId], references: [id])
  ruleVersion   CommunityRuleVersion? @relation(fields: [ruleVersionId, communityId], references: [id, communityId], onDelete: Restrict)
  members       CommunityMember[]

  @@unique([id, communityId], map: "CommunityInviteCode_id_communityId_key")
  @@index([communityId, status])
  @@index([ruleVersionId, communityId])
}

model CommunityMember {
  id                       String                   @id @default(cuid())
  communityId              String
  childId                  String
  inviteCodeId             String?
  ruleVersionId            String?
  adminReviewedByUserId    String?
  status                   CommunityMemberStatus    @default(pending_guardian)
  rosterVerificationStatus RosterVerificationStatus @default(pending)
  guardianConfirmedAt      DateTime?
  adminReviewedAt          DateTime?
  joinedAt                 DateTime?
  rosterEvidenceJson       Json?
  community                AuctionCommunity         @relation(fields: [communityId], references: [id])
  child                    ChildProfile             @relation(fields: [childId], references: [id])
  inviteCode               CommunityInviteCode?     @relation(fields: [inviteCodeId, communityId], references: [id, communityId], onDelete: Restrict)
  ruleVersion              CommunityRuleVersion?    @relation(fields: [ruleVersionId, communityId], references: [id, communityId], onDelete: Restrict)
  adminReviewedBy          User?                    @relation("CommunityMemberAdminReviewer", fields: [adminReviewedByUserId], references: [id])
  riskSignals              RiskSignal[]             @relation("RiskSignalCommunityMember")
  riskRestrictions         RiskRestriction[]        @relation("RiskRestrictionCommunityMember")

  @@unique([id, communityId, childId], map: "CommunityMember_id_communityId_childId_key")
  @@unique([communityId, childId])
  @@index([communityId, status])
  @@index([childId, status])
  @@index([inviteCodeId, communityId])
  @@index([ruleVersionId, communityId])
}

model UserSession {
  id                    String        @id @default(cuid())
  userId                String
  refreshTokenHash      String        @unique
  status                SessionStatus @default(active)
  deviceFingerprintHash String
  ipHash                String
  userAgentHash         String
  expiresAt             DateTime
  revokedAt             DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime      @default(now())
  user                  User          @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model TrustedDevice {
  id                    String                  @id @default(cuid())
  userId                String
  deviceFingerprintHash String
  deviceLabel           String?
  trustLevel            TrustedDeviceTrustLevel @default(normal)
  trustedAt             DateTime?
  revokedAt             DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime                @default(now())
  user                  User                    @relation(fields: [userId], references: [id])

  @@unique([userId, deviceFingerprintHash])
  @@index([userId, trustLevel])
}

model SensitiveOperationChallenge {
  id             String                            @id @default(cuid())
  actorUserId    String
  operation      String
  targetType     String
  targetId       String
  status         SensitiveOperationChallengeStatus @default(pending)
  riskLabelsJson Json?
  passedAt       DateTime?
  expiresAt      DateTime
  createdAt      DateTime                          @default(now())
  actor          User                              @relation("SensitiveOperationChallengeActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, status])
  @@index([targetType, targetId, status])
}

model ChildGuardianSettings {
  id                              String       @id @default(cuid())
  childId                         String       @unique
  canPublish                      Boolean      @default(false)
  canBid                          Boolean      @default(false)
  canUseCourier                   Boolean      @default(false)
  canUseGuardianArrangedDelivery  Boolean      @default(false)
  canFavorite                     Boolean      @default(false)
  bidRequiresGuardianConfirmation Boolean      @default(true)
  maxBidPoints                    Int?
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  child                           ChildProfile @relation(fields: [childId], references: [id])
}

model GuardianDispute {
  id                   String                @id @default(cuid())
  childId              String
  submittingGuardianId String
  type                 GuardianDisputeType
  status               GuardianDisputeStatus @default(pending_platform_review)
  frozenAt             DateTime?
  resolvedAt           DateTime?
  resolutionSummary    String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  child                ChildProfile          @relation(fields: [childId], references: [id])
  submittingGuardian   GuardianProfile       @relation(fields: [submittingGuardianId], references: [id])

  @@index([childId, status])
  @@index([submittingGuardianId, status])
}

model CommunityCreationRequest {
  id                   String                         @id @default(cuid())
  applicantGuardianId  String
  reviewedByUserId     String?
  approvedCommunityId  String?                        @unique
  status               CommunityCreationRequestStatus @default(pending_review)
  requestedName        String
  requestedDescription String?
  requestedGradeBand   String
  expectedMemberSize   Int
  ruleDraftJson        Json
  reviewedAt           DateTime?
  reviewNotes          String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  applicantGuardian    GuardianProfile                @relation(fields: [applicantGuardianId], references: [id])
  reviewedBy           User?                          @relation("CommunityCreationRequestReviewer", fields: [reviewedByUserId], references: [id])
  approvedCommunity    AuctionCommunity?              @relation("CommunityCreatedFromRequest", fields: [approvedCommunityId], references: [id])

  @@index([applicantGuardianId, status])
  @@index([status, createdAt])
}

model CommunityRuleVersion {
  id          String                     @id @default(cuid())
  communityId String
  versionNo   Int
  status      CommunityRuleVersionStatus @default(draft)
  rulesJson   Json
  effectiveAt DateTime?
  createdAt   DateTime                   @default(now())
  community   AuctionCommunity           @relation(fields: [communityId], references: [id])
  inviteCodes CommunityInviteCode[]
  members     CommunityMember[]

  @@unique([id, communityId], map: "CommunityRuleVersion_id_communityId_key")
  @@unique([communityId, versionNo])
  @@index([communityId, status])
}

model RiskSignal {
  id                String               @id @default(cuid())
  type              RiskSignalType
  scope             RiskRestrictionScope
  targetId          String
  targetUserId      String?
  communityMemberId String?
  communityId       String?
  childId           String?
  guardianId        String?
  evidenceJson      Json
  status            RiskSignalStatus     @default(open)
  reviewerUserId    String?
  reviewedAt        DateTime?
  resolutionText    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  targetUser        User?                @relation("RiskSignalTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  communityMember   CommunityMember?     @relation("RiskSignalCommunityMember", fields: [communityMemberId, communityId, childId], references: [id, communityId, childId], onDelete: Restrict)
  community         AuctionCommunity?    @relation(fields: [communityId], references: [id], onDelete: Restrict)
  child             ChildProfile?        @relation(fields: [childId], references: [id], onDelete: Restrict)
  guardian          GuardianProfile?     @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  reviewer          User?                @relation("RiskSignalReviewer", fields: [reviewerUserId], references: [id])
  restrictions      RiskRestriction[]    @relation("RiskSignalRestrictions")

  @@index([type, status])
  @@index([scope, targetId, status])
  @@index([childId, status])
  @@index([communityMemberId, communityId, childId])
}

model RiskRestriction {
  id                String                @id @default(cuid())
  type              RiskRestrictionType
  scope             RiskRestrictionScope
  targetId          String
  targetUserId      String?
  communityMemberId String?
  communityId       String?
  childId           String?
  guardianId        String?
  riskSignalId      String?
  status            RiskRestrictionStatus @default(active)
  reason            String
  imposedByUserId   String?
  startsAt          DateTime              @default(now())
  expiresAt         DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  targetUser        User?                 @relation("RiskRestrictionTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  communityMember   CommunityMember?      @relation("RiskRestrictionCommunityMember", fields: [communityMemberId, communityId, childId], references: [id, communityId, childId], onDelete: Restrict)
  community         AuctionCommunity?     @relation(fields: [communityId], references: [id], onDelete: Restrict)
  child             ChildProfile?         @relation(fields: [childId], references: [id], onDelete: Restrict)
  guardian          GuardianProfile?      @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  riskSignal        RiskSignal?           @relation("RiskSignalRestrictions", fields: [riskSignalId], references: [id], onDelete: Restrict)
  imposedBy         User?                 @relation("RiskRestrictionImposedBy", fields: [imposedByUserId], references: [id])

  @@index([scope, targetId, status], map: "RiskRestriction_scope_target_status_idx")
  @@index([riskSignalId, status])
  @@index([communityId, status])
  @@index([childId, status])
  @@index([communityMemberId, communityId, childId])
}

model MediaAsset {
  id                  String               @id @default(cuid())
  ownerUserId         String
  storageBucket       String
  storageKey          String
  visibility          MediaVisibility      @default(temp_private)
  mimeType            String
  sizeBytes           Int
  checksum            String
  accessPolicyVersion Int                  @default(1)
  revokedAt           DateTime?
  createdAt           DateTime             @default(now())
  contentVersionMedia ContentVersionMedia?
  appealAttachment    AppealAttachment?

  @@index([ownerUserId, visibility])
}

model DeliveryPoint {
  id                String              @id @default(cuid())
  communityId       String
  name              String
  addressText       String
  availableTimeText String
  status            DeliveryPointStatus @default(active)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  community         AuctionCommunity    @relation(fields: [communityId], references: [id])
  deliveryRecords   DeliveryRecord[]

  @@index([communityId, status])
}

model Item {
  id                     String           @id @default(cuid())
  communityId            String
  sellerChildId          String
  status                 ItemStatus       @default(draft)
  startPoints            Int
  minIncrementPoints     Int
  currentPublicVersionId String?
  latestVersionId        String?
  version                Int              @default(1)
  createdAt              DateTime         @default(now())
  community              AuctionCommunity @relation(fields: [communityId], references: [id])
  sellerChild            ChildProfile     @relation(fields: [sellerChildId], references: [id])
  currentPublicVersion   ContentVersion?  @relation("ItemCurrentPublicVersion", fields: [currentPublicVersionId], references: [id])
  latestVersion          ContentVersion?  @relation("ItemLatestVersion", fields: [latestVersionId], references: [id])
  auctionSession         AuctionSession?
  wantedResponses        WantedResponse[]
  favorites              ItemFavorite[]

  @@index([communityId, status])
  @@index([sellerChildId])
}

model WantedPost {
  id                     String           @id @default(cuid())
  communityId            String
  childId                String
  status                 WantedPostStatus @default(draft)
  category               String?
  currentPublicVersionId String?
  latestVersionId        String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  community              AuctionCommunity @relation(fields: [communityId], references: [id])
  child                  ChildProfile     @relation(fields: [childId], references: [id])
  currentPublicVersion   ContentVersion?  @relation("WantedPostCurrentPublicVersion", fields: [currentPublicVersionId], references: [id])
  latestVersion          ContentVersion?  @relation("WantedPostLatestVersion", fields: [latestVersionId], references: [id])
  responses              WantedResponse[]

  @@index([communityId, status])
  @@index([childId])
}

model WantedResponse {
  id                     String               @id @default(cuid())
  wantedPostId           String
  responderChildId       String
  itemId                 String?
  status                 WantedResponseStatus @default(submitted)
  currentPublicVersionId String?
  latestVersionId        String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  wantedPost             WantedPost           @relation(fields: [wantedPostId], references: [id])
  responderChild         ChildProfile         @relation(fields: [responderChildId], references: [id])
  item                   Item?                @relation(fields: [itemId], references: [id])
  currentPublicVersion   ContentVersion?      @relation("WantedResponseCurrentPublicVersion", fields: [currentPublicVersionId], references: [id])
  latestVersion          ContentVersion?      @relation("WantedResponseLatestVersion", fields: [latestVersionId], references: [id])

  @@index([wantedPostId, status])
  @@index([responderChildId])
  @@index([itemId])
}

model ContentVersion {
  id                          String                @id @default(cuid())
  targetType                  ContentTargetType
  targetId                    String
  versionNo                   Int
  status                      ContentVersionStatus  @default(pending_ai)
  title                       String?
  description                 String?
  payloadJson                 Json
  riskLevel                   String?
  approvedAt                  DateTime?
  createdAt                   DateTime              @default(now())
  task                        ModerationTask?
  media                       ContentVersionMedia[]
  aiReviewResults             AiReviewResult[]
  manualReviewRecords         ManualReviewRecord[]
  itemCurrentPublic           Item[]                @relation("ItemCurrentPublicVersion")
  itemLatest                  Item[]                @relation("ItemLatestVersion")
  wantedPostCurrentPublic     WantedPost[]          @relation("WantedPostCurrentPublicVersion")
  wantedPostLatest            WantedPost[]          @relation("WantedPostLatestVersion")
  wantedResponseCurrentPublic WantedResponse[]      @relation("WantedResponseCurrentPublicVersion")
  wantedResponseLatest        WantedResponse[]      @relation("WantedResponseLatestVersion")
  searchIndexDocuments        SearchIndexDocument[]

  @@unique([targetType, targetId, versionNo])
  @@index([targetType, targetId, status])
}

model ContentVersionMedia {
  id               String           @id @default(cuid())
  contentVersionId String
  mediaAssetId     String           @unique
  mediaRole        ContentMediaRole
  sortOrder        Int
  createdAt        DateTime         @default(now())
  contentVersion   ContentVersion   @relation(fields: [contentVersionId], references: [id])
  mediaAsset       MediaAsset       @relation(fields: [mediaAssetId], references: [id])

  @@unique([contentVersionId, mediaRole])
  @@unique([contentVersionId, sortOrder])
  @@index([contentVersionId])
}

model ModerationTask {
  id                  String               @id @default(cuid())
  contentVersionId    String               @unique
  status              ModerationTaskStatus @default(pending)
  providerRiskLevel   String?
  ruleTagsJson        Json?
  reviewerUserId      String?
  reviewedAt          DateTime?
  failureReason       String?
  contentVersion      ContentVersion       @relation(fields: [contentVersionId], references: [id])
  aiReviewResults     AiReviewResult[]
  manualReviewRecords ManualReviewRecord[]
}

model AiReviewResult {
  id                   String           @id @default(cuid())
  taskId               String
  contentVersionId     String
  provider             String
  providerStatus       AiProviderStatus
  riskLevel            String?
  labelsJson           Json?
  ocrText              String?
  qrOrBarcodeDetected  Boolean          @default(false)
  metadataFindingsJson Json?
  failureReason        String?
  rawResultRef         String?
  createdAt            DateTime         @default(now())
  task                 ModerationTask   @relation(fields: [taskId], references: [id])
  contentVersion       ContentVersion   @relation(fields: [contentVersionId], references: [id])

  @@index([taskId, createdAt])
  @@index([contentVersionId, createdAt])
}

model ManualReviewRecord {
  id               String               @id @default(cuid())
  taskId           String
  contentVersionId String
  reviewerUserId   String
  decision         ManualReviewDecision
  reason           String
  createdAt        DateTime             @default(now())
  task             ModerationTask       @relation(fields: [taskId], references: [id])
  contentVersion   ContentVersion       @relation(fields: [contentVersionId], references: [id])
  reviewer         User                 @relation("ManualReviewRecordReviewer", fields: [reviewerUserId], references: [id])

  @@index([taskId, createdAt])
  @@index([contentVersionId, createdAt])
  @@index([reviewerUserId, createdAt])
}

model AuctionSession {
  id                     String               @id @default(cuid())
  itemId                 String               @unique
  idempotencyKey         String               @unique
  status                 AuctionSessionStatus @default(active)
  startAt                DateTime
  endAt                  DateTime
  startPoints            Int
  minIncrementPoints     Int
  currentPricePoints     Int                  @default(0)
  highestBidId           String?
  highestBidderChildId   String?
  createdByUserId        String?
  createdAt              DateTime             @default(now())
  settledAt              DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  settlementAttemptCount Int                  @default(0)
  lastSettlementError    String?
  version                Int                  @default(1)
  item                   Item                 @relation(fields: [itemId], references: [id])
  createdBy              User?                @relation("AuctionSessionCreatedBy", fields: [createdByUserId], references: [id])
  bids                   Bid[]
  pointHolds             PointHold[]
  transaction            Transaction?

  @@index([status, endAt])
  @@index([itemId, status])
}

model Bid {
  id               String         @id @default(cuid())
  auctionSessionId String
  bidderChildId    String
  amountPoints     Int
  status           BidStatus      @default(active)
  idempotencyKey   String         @unique
  createdAt        DateTime       @default(now())
  withdrawnAt      DateTime?
  outbidAt         DateTime?
  invalidatedAt    DateTime?
  auctionSession   AuctionSession @relation(fields: [auctionSessionId], references: [id])
  bidderChild      ChildProfile   @relation(fields: [bidderChildId], references: [id])
  pointHold        PointHold?

  @@index([auctionSessionId, createdAt])
}

model PointAccount {
  id                 String             @id @default(cuid())
  childId            String             @unique
  availablePoints    Int                @default(0)
  frozenPoints       Int                @default(0)
  totalEarnedPoints  Int                @default(0)
  totalSpentPoints   Int                @default(0)
  totalAwardedPoints Int                @default(0)
  totalPenaltyPoints Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  child              ChildProfile       @relation(fields: [childId], references: [id])
  holds              PointHold[]
  ledgerEntries      PointLedgerEntry[]
  ledgerCheckDiffs   LedgerCheckDiff[]
}

model PointHold {
  id               String          @id @default(cuid())
  accountId        String
  auctionSessionId String
  bidId            String?         @unique
  amountPoints     Int
  status           PointHoldStatus @default(active)
  createdAt        DateTime        @default(now())
  releasedAt       DateTime?
  transferredAt    DateTime?
  account          PointAccount    @relation(fields: [accountId], references: [id])
  auctionSession   AuctionSession  @relation(fields: [auctionSessionId], references: [id])
  bid              Bid?            @relation(fields: [bidId], references: [id])

  @@index([auctionSessionId, status])
}

model PointLedgerEntry {
  id                String                  @id @default(cuid())
  accountId         String
  childId           String
  type              PointLedgerEntryType
  amountPoints      Int
  availableAfter    Int
  frozenAfter       Int
  relatedType       String
  relatedId         String
  idempotencyKey    String                  @unique
  reason            String
  createdByUserId   String?
  createdAt         DateTime                @default(now())
  account           PointAccount            @relation(fields: [accountId], references: [id])
  child             ChildProfile            @relation(fields: [childId], references: [id])
  createdBy         User?                   @relation(fields: [createdByUserId], references: [id])
  adjustmentRequest PointAdjustmentRequest? @relation("PointAdjustmentLedgerEntry")

  @@index([accountId, createdAt])
  @@index([childId, createdAt])
}

model PointAdjustmentRequest {
  id                     String                     @id @default(cuid())
  source                 PointAdjustmentSource
  requestType            PointAdjustmentRequestType
  status                 PointAdjustmentStatus      @default(pending_review)
  childId                String
  guardianId             String?
  requestedByUserId      String
  reviewedByUserId       String?
  secondReviewedByUserId String?
  ledgerEntryId          String?                    @unique
  requestedPoints        Int
  reason                 String
  reviewReason           String?
  secondReviewReason     String?
  requiresSecondReview   Boolean                    @default(false)
  batchKey               String?
  idempotencyKey         String                     @unique
  createdAt              DateTime                   @default(now())
  reviewedAt             DateTime?
  secondReviewedAt       DateTime?
  decidedAt              DateTime?
  updatedAt              DateTime                   @updatedAt
  child                  ChildProfile               @relation(fields: [childId], references: [id])
  guardian               GuardianProfile?           @relation(fields: [guardianId], references: [id])
  requestedBy            User                       @relation("PointAdjustmentRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy             User?                      @relation("PointAdjustmentReviewedBy", fields: [reviewedByUserId], references: [id])
  secondReviewedBy       User?                      @relation("PointAdjustmentSecondReviewedBy", fields: [secondReviewedByUserId], references: [id])
  ledgerEntry            PointLedgerEntry?          @relation("PointAdjustmentLedgerEntry", fields: [ledgerEntryId], references: [id])

  @@index([status, requiresSecondReview])
  @@index([childId, createdAt])
  @@index([guardianId, status])
  @@index([batchKey])
}

model LedgerCheckRun {
  id                  String               @id @default(cuid())
  status              LedgerCheckRunStatus @default(running)
  checkedAccountCount Int                  @default(0)
  ledgerDiffCount     Int                  @default(0)
  negativeReplayCount Int                  @default(0)
  orphanLedgerCount   Int                  @default(0)
  startedAt           DateTime             @default(now())
  finishedAt          DateTime?
  workerName          String?
  failureReason       String?
  idempotencyKey      String               @unique
  diffs               LedgerCheckDiff[]

  @@index([status, startedAt])
}

model LedgerCheckDiff {
  id                      String              @id @default(cuid())
  runId                   String
  accountId               String?
  childId                 String?
  ledgerEntryId           String?
  diffType                LedgerCheckDiffType
  expectedAvailablePoints Int?
  actualAvailablePoints   Int?
  expectedFrozenPoints    Int?
  actualFrozenPoints      Int?
  evidenceJson            Json
  createdAt               DateTime            @default(now())
  run                     LedgerCheckRun      @relation(fields: [runId], references: [id])
  account                 PointAccount?       @relation(fields: [accountId], references: [id])

  @@index([runId, diffType])
  @@index([accountId, createdAt])
  @@index([childId, createdAt])
}

model Transaction {
  id                        String             @id @default(cuid())
  auctionSessionId          String             @unique
  buyerChildId              String
  sellerChildId             String
  pointHoldId               String
  pointsAmount              Int
  status                    TransactionStatus  @default(pending_guardian_confirm)
  guardianConfirmDeadlineAt DateTime
  deliveryConfirmDeadlineAt DateTime?
  version                   Int                @default(1)
  createdAt                 DateTime           @default(now())
  auctionSession            AuctionSession     @relation(fields: [auctionSessionId], references: [id])
  decisions                 GuardianDecision[]
  deliveryRecord            DeliveryRecord?
  appeals                   Appeal[]
}

model GuardianDecision {
  id                 String           @id @default(cuid())
  transactionId      String
  guardianId         String
  phase              DecisionPhase
  value              DecisionValue
  side               TransactionSide?
  childId            String?
  guardianRole       GuardianRole?
  transactionVersion Int?
  reason             String?
  effective          Boolean          @default(true)
  createdAt          DateTime         @default(now())
  transaction        Transaction      @relation(fields: [transactionId], references: [id])
  child              ChildProfile?    @relation(fields: [childId], references: [id])

  @@index([transactionId, phase, effective])
  @@index([transactionId, phase, side, effective])
}

model DeliveryRecord {
  id                String               @id @default(cuid())
  transactionId     String               @unique
  deliveryMethod    DeliveryMethod
  deliveryPointId   String?
  sellerConfirmedAt DateTime?
  buyerConfirmedAt  DateTime?
  status            DeliveryRecordStatus @default(pending)
  deadlineAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  transaction       Transaction          @relation(fields: [transactionId], references: [id])
  deliveryPoint     DeliveryPoint?       @relation(fields: [deliveryPointId], references: [id])

  @@index([deliveryMethod, status])
  @@index([deliveryPointId, status])
}

model Appeal {
  id                    String             @id @default(cuid())
  targetType            AppealTargetType
  targetId              String
  transactionId         String?
  submittedByGuardianId String
  communityId           String
  status                AppealStatus       @default(pending_activity_admin)
  reason                String
  resolution            String?
  reviewedByUserId      String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  resolvedAt            DateTime?
  transaction           Transaction?       @relation(fields: [transactionId], references: [id])
  submittedByGuardian   GuardianProfile    @relation("GuardianSubmittedAppeals", fields: [submittedByGuardianId], references: [id])
  community             AuctionCommunity   @relation(fields: [communityId], references: [id])
  reviewedBy            User?              @relation("AppealReviewer", fields: [reviewedByUserId], references: [id])
  attachments           AppealAttachment[]

  @@index([communityId, status])
  @@index([submittedByGuardianId, status])
  @@index([transactionId, status])
}

model AppealAttachment {
  id              String                 @id @default(cuid())
  appealId        String
  mediaAssetId    String                 @unique
  status          AppealAttachmentStatus @default(pending_scan)
  sortOrder       Int
  riskLabelsJson  Json?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  reviewedAt      DateTime?
  appeal          Appeal                 @relation(fields: [appealId], references: [id])
  mediaAsset      MediaAsset             @relation(fields: [mediaAssetId], references: [id])

  @@unique([appealId, sortOrder])
  @@index([appealId, status])
}

model IdempotencyRecord {
  id           String            @id @default(cuid())
  key          String
  actorUserId  String
  action       String
  targetType   String
  targetId     String
  requestHash  String
  status       IdempotencyStatus @default(processing)
  responseJson Json?
  createdAt    DateTime          @default(now())

  @@unique([key, actorUserId, action, targetType, targetId])
}

model OutboxEvent {
  id             String         @id @default(cuid())
  eventType      String
  targetType     String
  targetId       String
  idempotencyKey String         @unique
  payloadJson    Json
  status         OutboxStatus   @default(pending)
  availableAt    DateTime       @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  attempts       Int            @default(0)
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([status, availableAt])
}

model Notification {
  id               String                     @id @default(cuid())
  recipientUserId  String
  recipientChildId String?
  type             NotificationType
  priority         NotificationPriority       @default(normal)
  mandatory        Boolean                    @default(false)
  title            String
  body             String
  relatedType      String
  relatedId        String
  eventId          String?
  targetVersion    Int?
  actionType       NotificationActionType?
  deliveryStatus   NotificationDeliveryStatus @default(pending)
  readAt           DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  recipient        User                       @relation(fields: [recipientUserId], references: [id])
  recipientChild   ChildProfile?              @relation(fields: [recipientChildId], references: [id])
  event            OutboxEvent?               @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientUserId, recipientChildId, readAt, createdAt])
  @@index([eventId, recipientUserId, recipientChildId, type])
  @@index([relatedType, relatedId, createdAt])
}

model NotificationPreference {
  id                     String        @id @default(cuid())
  userId                 String
  childId                String?
  eventType              String
  inAppEnabled           Boolean       @default(true)
  wechatSubscribeEnabled Boolean       @default(false)
  childVisible           Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id])
  child                  ChildProfile? @relation(fields: [childId], references: [id])

  @@unique([userId, childId, eventType])
  @@index([userId, eventType])
}

model SearchIndexDocument {
  id               String                      @id @default(cuid())
  targetType       SearchIndexTargetType
  targetId         String
  contentVersionId String
  communityId      String
  visibilityStatus SearchIndexVisibilityStatus @default(searchable)
  searchPayload    Json
  searchText       String
  category         String?
  indexedAt        DateTime                    @default(now())
  sourceVersion    Int
  sourceCreatedAt  DateTime
  auctionEndAt     DateTime?
  bidCount         Int                         @default(0)
  favoriteCount    Int                         @default(0)
  community        AuctionCommunity            @relation(fields: [communityId], references: [id])
  contentVersion   ContentVersion              @relation(fields: [contentVersionId], references: [id])

  @@unique([targetType, targetId])
  @@index([communityId, visibilityStatus, indexedAt])
  @@index([communityId, targetType, visibilityStatus, indexedAt])
  @@index([communityId, category, visibilityStatus, indexedAt])
  @@index([communityId, visibilityStatus, auctionEndAt])
  @@index([communityId, visibilityStatus, bidCount])
  @@index([communityId, visibilityStatus, favoriteCount])
}

model ItemFavorite {
  id          String             @id @default(cuid())
  childId     String
  itemId      String
  communityId String
  status      ItemFavoriteStatus @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  removedAt   DateTime?
  child       ChildProfile       @relation(fields: [childId], references: [id])
  item        Item               @relation(fields: [itemId], references: [id])
  community   AuctionCommunity   @relation(fields: [communityId], references: [id])

  @@unique([childId, itemId])
  @@index([childId, communityId, status, updatedAt])
  @@index([itemId, status])
  @@index([communityId, status, updatedAt])
}

model GovernanceControl {
  id                String                     @id @default(cuid())
  scopeType         GovernanceControlScopeType
  scopeId           String?
  controlType       GovernanceControlType
  status            GovernanceControlStatus    @default(active)
  reason            String
  previewAuditLogId String                     @unique
  createdByUserId   String
  liftedByUserId    String?
  startsAt          DateTime                   @default(now())
  endsAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  liftedAt          DateTime?
  liftReason        String?
  community         AuctionCommunity?          @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  previewAuditLog   AuditLog                   @relation("GovernanceControlPreview", fields: [previewAuditLogId], references: [id], onDelete: Restrict)
  createdByUser     User                       @relation("GovernanceControlCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  liftedByUser      User?                      @relation("GovernanceControlLiftedBy", fields: [liftedByUserId], references: [id], onDelete: Restrict)

  @@index([scopeType, scopeId, controlType, status])
  @@index([createdByUserId, createdAt])
  @@index([status, startsAt, endsAt])
}

model HighRiskGovernanceReviewRequest {
  id                      String                                 @id @default(cuid())
  actionType              HighRiskGovernanceReviewActionType
  decisionState           HighRiskGovernanceReviewDecisionState  @default(pending)
  executionState          HighRiskGovernanceReviewExecutionState @default(not_started)
  targetType              String
  targetId                String
  scopeType               GovernanceControlScopeType?
  scopeId                 String?
  controlType             GovernanceControlType?
  sourcePreviewAuditLogId String?                                @unique
  initiatorUserId         String
  reviewerUserId          String?
  idempotencyKey          String
  requestHash             String
  frozenPayloadJson       Json
  evidenceJson            Json
  decisionReason          String?
  executionErrorCode      String?
  expiresAt               DateTime
  decidedAt               DateTime?
  executedAt              DateTime?
  createdAt               DateTime                               @default(now())
  updatedAt               DateTime                               @updatedAt
  community               AuctionCommunity?                      @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  sourcePreviewAuditLog   AuditLog?                              @relation("HighRiskGovernanceReviewSourcePreview", fields: [sourcePreviewAuditLogId], references: [id], onDelete: Restrict)
  initiator               User                                   @relation("HighRiskGovernanceReviewInitiator", fields: [initiatorUserId], references: [id], onDelete: Restrict)
  reviewer                User?                                  @relation("HighRiskGovernanceReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  events                  HighRiskGovernanceReviewEvent[]

  @@unique([initiatorUserId, actionType, targetType, targetId, idempotencyKey])
  @@index([decisionState, expiresAt])
  @@index([targetType, targetId, decisionState])
  @@index([scopeType, scopeId, controlType, decisionState])
  @@index([reviewerUserId, decidedAt])
}

model HighRiskGovernanceReviewEvent {
  id                 String                                  @id @default(cuid())
  requestId          String
  eventType          HighRiskGovernanceReviewEventType
  actorUserId        String?
  reason             String?
  errorCode          String?
  fromDecisionState  HighRiskGovernanceReviewDecisionState?
  toDecisionState    HighRiskGovernanceReviewDecisionState?
  fromExecutionState HighRiskGovernanceReviewExecutionState?
  toExecutionState   HighRiskGovernanceReviewExecutionState?
  targetType         String
  targetId           String
  payloadSummaryJson Json?
  createdAt          DateTime                                @default(now())
  request            HighRiskGovernanceReviewRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor              User?                                   @relation("HighRiskGovernanceReviewEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
}

model AuditLog {
  id                             String                           @id @default(cuid())
  actorUserId                    String?
  action                         String
  targetType                     String
  targetId                       String
  reason                         String?
  beforeJson                     Json?
  afterJson                      Json?
  createdAt                      DateTime                         @default(now())
  actor                          User?                            @relation(fields: [actorUserId], references: [id])
  governanceControlPreview       GovernanceControl?               @relation("GovernanceControlPreview")
  highRiskGovernanceReviewSource HighRiskGovernanceReviewRequest? @relation("HighRiskGovernanceReviewSourcePreview")

  @@index([targetType, targetId, createdAt])
}
